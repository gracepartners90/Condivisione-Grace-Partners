---
/**
 * CTASection — variants:
 * - `band`: closing statement with a CTA and quick contacts (Home).
 * - `form`: closing statement followed by the contact form (line pages).
 */
import { nb } from '../../lib/text';
import Passage from '../ui/Passage.astro';
import Cta from '../ui/Cta.astro';
import { site } from '../../data/site';

interface Props {
  variant?: 'band' | 'form';
  eyebrow?: string;
  title: string[];
  text?: string;
  cta?: { label: string; href: string; id: string };
  location?: string;
  surface?: 'calce' | 'pietra' | 'notte';
  id?: string;
  size?: 'xl' | 'l' | 'm';
  secondSize?: 'xl' | 'l' | 'm' | 's' | 'same';
  /** Secondary link under the statement (e.g. the portal on line pages). */
  secondary?: { label: string; href: string; id: string; srText?: string; destinationId?: string };
  /** form variant: statement beside the form (`side`) or above it (`stack`). */
  layout?: 'side' | 'stack';
}

const {
  variant = 'band',
  eyebrow,
  title,
  text,
  cta,
  location = 'chiusura',
  surface = 'notte',
  id,
  size = variant === 'band' ? 'xl' : 'l',
  secondSize = 'same',
  secondary,
  layout = 'side',
} = Astro.props;
const trackPrefix = cta?.id.replace(/-[^-]+$/, '') ?? 'chiusura';
---

<section
  id={id}
  class:list={['cta-section', `cta-section--${variant}`, `cta-section--${layout}`, `surface-${surface}`]}
  aria-labelledby={`${id ?? 'chiusura'}-title`}
>
  <div class="wrap grid cta-section__grid">
    {eyebrow && <p class="cta-section__eyebrow t-label">{eyebrow}</p>}
    <Passage as="h2" id={`${id ?? 'chiusura'}-title`} registers={title} size={size} secondSize={secondSize} class="cta-section__title" />
    {
      (text || cta || secondary) && (
        <div class="cta-section__body" data-reveal>
          {text && <p class="cta-section__text">{text}</p>}
          {cta && <Cta href={cta.href} label={cta.label} variant="primary" size="large" ctaId={cta.id} location={location} />}
          {secondary && (
            <Cta
              href={secondary.href}
              label={secondary.label}
              srText={secondary.srText}
              variant="link"
              ctaId={secondary.id}
              location={location}
              destinationId={secondary.destinationId}
              outboundType="portale"
            />
          )}
          {variant === 'band' && (
            <ul role="list" class="cta-section__contacts t-label">
              <li>
                <a href={`mailto:${site.email}`} data-track="contact_click" data-cta-id={`${trackPrefix}-email`} data-cta-location={location} data-contact-method="email">
                  <span>Scrivi a <span class="t-as-is">{site.email}</span></span>
                </a>
              </li>
              <li>
                <a href={site.phone.href} data-track="contact_click" data-cta-id={`${trackPrefix}-telefono`} data-cta-location={location} data-contact-method="telefono">
                  Chiama {nb(site.phone.display)}
                </a>
              </li>
            </ul>
          )}
        </div>
      )
    }
    {
      Astro.slots.has('default') && (
        <div class="cta-section__form">
          <slot />
        </div>
      )
    }
  </div>
</section>

<style>
  .cta-section {
    padding-block: var(--section-pad);
  }

  .cta-section__grid {
    row-gap: var(--space-xl);
  }

  .cta-section__eyebrow {
    grid-column: 1 / -1;
    color: var(--fg-2);
  }

  .cta-section :global(.cta-section__title) {
    grid-column: 1 / -1;
  }

  .cta-section__body {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--space-l);
    justify-items: start;
  }

  .cta-section__text {
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    max-width: var(--measure-lead);
    color: var(--fg);
  }

  .cta-section__contacts {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
  }

  /* Flex trims the spaces at the edges of its items: keep each label in one span. */
  .cta-section__contacts a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
  }

  @media (max-width: 43.74em) {
    .cta-section--band .cta-section__body :global(.cta) {
      width: 100%;
      justify-content: center;
    }
  }

  .cta-section__form {
    grid-column: 1 / -1;
  }

  @media (min-width: 64em) {
    .cta-section--band .cta-section__body {
      grid-column: 7 / span 6;
    }

    /* SIII: statement on columns 1–5, form on 7–12 (visual direction §7.4). */
    .cta-section--form.cta-section--side .cta-section__eyebrow,
    .cta-section--form.cta-section--side .cta-section__body {
      grid-column: 1 / span 5;
    }

    /* The title may use the empty sixth column: «un’esperienza.» in display-l needs 6.6 em. */
    .cta-section--form.cta-section--side :global(.cta-section__title) {
      grid-column: 1 / span 6;
    }

    .cta-section--form.cta-section--side .cta-section__form {
      grid-column: 7 / -1;
      grid-row: 1 / span 4;
    }

    .cta-section--form .cta-section__grid {
      align-items: start;
    }

    /* Puglia Digitale and Città Digitali: statement across, the form below it (§7.5–7.6). */
    .cta-section--form.cta-section--stack :global(.cta-section__title) {
      grid-column: 1 / span 11;
    }

    .cta-section--form.cta-section--stack .cta-section__form {
      margin-top: var(--space-xl);
    }
  }
</style>

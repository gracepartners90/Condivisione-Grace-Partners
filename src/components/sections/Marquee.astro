---
/**
 * Typographic marquee linked to scroll (visual direction §6): it moves only while the user
 * scrolls, never on its own, so no pause control is needed (WCAG 2.2.2 does not apply).
 * Static with prefers-reduced-motion or without scroll-driven animations. Decorative.
 */
import Arrow from '../ui/Arrow.astro';

interface Props {
  items: string[];
  /** Arrows for the chain of the Home, dots for a list of verbs. */
  separator?: 'arrow' | 'dot';
  size?: 'm' | 'xl';
  class?: string;
}

const { items, separator = 'arrow', size = 'm', class: className } = Astro.props;
const copies = [0, 1, 2];
---

<div class:list={['marquee', `marquee--${size}`, className]} aria-hidden="true">
  <div class="marquee__track">
    {
      copies.map(() => (
        <span class="marquee__group">
          {items.map((item) => (
            <span class="marquee__item">
              {item}
              {separator === 'arrow' ? <Arrow dir="right" class="marquee__arrow" /> : <span class="marquee__sep">·</span>}
            </span>
          ))}
        </span>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    overflow: clip;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    border-block: 1px solid var(--line);
    padding-block: var(--space-m);
  }

  .marquee__track {
    display: flex;
    width: max-content;
  }

  .marquee__group,
  .marquee__item {
    display: inline-flex;
    align-items: center;
  }

  .marquee__item {
    gap: 0.35em;
    padding-right: 0.45em;
    font-size: var(--fs-display-m);
    line-height: 1.1;
    letter-spacing: var(--tr-display-m);
    white-space: nowrap;
  }

  .marquee--xl .marquee__item {
    font-size: var(--fs-display-xl);
    letter-spacing: var(--tr-display-xl);
    font-weight: var(--fw-strong);
    gap: 0.4em;
    padding-right: 0.4em;
  }

  /* Separators are glyphs in the secondary colour: orange marks places only (§2), and a
     node is never a bullet (§1.3). */
  .marquee__sep {
    color: var(--fg-2);
  }

  .marquee__item :global(.marquee__arrow) {
    width: 0.62em;
    height: 0.62em;
    color: var(--fg-2);
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .marquee__track {
        animation-name: marquee-scroll;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: cover;
      }
    }
  }

  /* About 0.4× the scroll speed for a one-line band (docs/performance/architettura.md §6.5). */
  @keyframes marquee-scroll {
    to {
      transform: translateX(-45svh);
    }
  }
</style>

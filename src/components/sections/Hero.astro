---
/**
 * Hero — variants (component system, guidelines §30):
 * - `home`: «L'orizzonte dei luoghi». H1 in two registers standing on the graduated horizon,
 *   sky (calce) above, earth (pietra) below (visual direction §5).
 * - `line`: inner pages. H1 = name + descriptor on two levels, statement, CTAs, visual slot.
 * - `compact`: Contatti. H1 only, then the page continues.
 */
import Horizon, { type HorizonPlace } from '../ui/Horizon.astro';

interface Props {
  variant?: 'home' | 'line' | 'compact';
  eyebrow?: string;
  /** home: [first register, second register]; second may contain "\n" authored breaks. */
  registers?: string[];
  /** line: name (large) and descriptor (smaller) inside the same H1. */
  name?: string;
  descriptor?: string;
  places?: HorizonPlace[];
  /** home: the positioning line in `lead`, right after the H1 (visual direction §5). */
  lead?: string;
  caption?: string;
  surface?: 'calce' | 'pietra' | 'notte';
  /** line: scale of the name. «SIII» (four letters) can be huge. */
  nameSize?: 'xl' | 'xxl';
  class?: string;
}

const {
  variant = 'line',
  eyebrow,
  registers = [],
  name,
  descriptor,
  places = [],
  lead,
  caption,
  surface = 'calce',
  nameSize = 'xl',
  class: className,
} = Astro.props;
const [first = '', second = ''] = registers;
const secondLines = second.split('\n');
---

{
  variant === 'home' ? (
    <section class:list={['hero hero--home surface-calce', className]} aria-labelledby="hero-title">
      <div class="wrap hero-home">
        {eyebrow && <p class="hero-home__kicker t-label">{eyebrow}</p>}
        <h1 id="hero-title" class="hero-home__title">
          <span class="hero-home__r1">
            <span class="hero-home__line">{first}</span>
          </span>{' '}
          <span class="hero-home__r2">
            {secondLines.map((line, i) => (
              <>
                <span class="hero-home__line">{line}</span>
                {i < secondLines.length - 1 && ' '}
              </>
            ))}
          </span>
        </h1>
        {lead && <p class="hero-home__lead t-lead">{lead}</p>}
        <div class="hero-home__horizon">
          {/* Mobile centre 238° instead of 250°: the Murgia group (251–256°) hangs to the left of its
              node and must stay inside the window (visual direction §5, C14-1). */}
          <Horizon places={places} centers={{ m: 238, t: 170, d: 170 }} />
        </div>
        {caption && (
          <p class="hero-home__caption t-label">
            {caption.split('\n').map((line) => (
              <span aria-hidden={/\d°/.test(line) ? 'true' : undefined}>{line}</span>
            ))}
          </p>
        )}
      </div>
    </section>
  ) : (
    <section class:list={['hero', `hero--${variant}`, `surface-${surface}`, className]} aria-labelledby="hero-title">
      <div class="wrap hero-line grid">
        {eyebrow && <p class="hero-line__eyebrow t-label">{eyebrow}</p>}
        <h1 id="hero-title" class="hero-line__title">
          <span class:list={['hero-line__name', `hero-line__name--${nameSize}`]}>{name}</span>
          {descriptor && (
            <>
              <span class="sr-only"> – </span>
              <span class="hero-line__descriptor">{descriptor}</span>
            </>
          )}
        </h1>
        <div class="hero-line__body">
          <slot />
        </div>
        {Astro.slots.has('visual') && (
          <div class="hero-line__visual">
            <slot name="visual" />
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  /* ─── Home ─── */
  .hero--home {
    position: relative;
    overflow: clip;
  }

  .hero-home {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    column-gap: var(--gutter);
    grid-template-rows: [sky] auto [line] 0 [earth] auto [lead] auto [foot] auto;
    padding-top: clamp(var(--space-xl), 8vh, var(--space-3xl));
  }

  /* Positioning line (visual direction §5; G4 verdict, I4): what ITnode does, in reading order
     right after the H1. A paragraph, not part of the heading. */
  .hero-home__lead {
    grid-column: 1 / -1;
    grid-row: lead;
    margin: var(--space-m) 0 0;
    position: relative;
    z-index: 1;
  }

  .hero-home__kicker {
    grid-column: 1 / -1;
    grid-row: sky;
    align-self: start;
    color: var(--fg-2);
    max-width: 40ch;
  }

  /* The H1 spans sky, line and earth; subgrid lets each register sit in its field. */
  .hero-home__title {
    grid-column: 1 / -1;
    grid-row: sky / span 3;
    display: grid;
    grid-template-rows: subgrid;
    margin: 0;
    font-weight: var(--fw-strong);
    position: relative;
    z-index: 1;
  }

  .hero-home__r1 {
    grid-row: 1;
    align-self: end;
    display: block;
    padding-top: clamp(var(--space-2xl), 14vh, 11rem);
    font-size: var(--fs-display-xl);
    line-height: var(--lh-display-xl);
    letter-spacing: var(--tr-display-xl);
    /* The descender of «g» (0.21 em) touches the horizon without crossing it: measured with
       the real font from 320 to 1920 px, the ink stays within 2 px above the line. */
    margin-bottom: calc(var(--fs-display-xl) * 0.11);
  }

  .hero-home__r2 {
    grid-row: 3;
    display: block;
    padding-top: 9.5rem;
    font-size: var(--fs-display-m);
    line-height: var(--lh-display-m);
    letter-spacing: var(--tr-display-m);
    font-weight: var(--fw-regular);
  }

  .hero-home__line {
    display: block;
  }

  .hero-home__horizon {
    grid-column: 1 / -1;
    grid-row: line;
    position: relative;
    z-index: 0;
  }

  /* The earth: pietra from the horizon down, continuing into the next section. */
  .hero-home__horizon::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 100vw;
    height: 200vh;
    transform: translateX(-50%);
    background: var(--pietra);
  }

  .hero-home__caption {
    grid-column: 1 / -1;
    grid-row: foot;
    position: relative;
    z-index: 1;
    margin-top: var(--space-l);
    padding-bottom: var(--space-2xl);
    color: var(--fg-2);
  }

  .hero-home__caption span {
    display: block;
  }

  /* Reserve the earth row height used by the second register on the caption row too. */
  .hero-home__title,
  .hero-home__caption {
    min-width: 0;
  }

  @media (min-width: 43.75em) {
    .hero-home__r2 {
      padding-top: calc(7rem + var(--space-s));
      padding-left: calc((100% + var(--gutter)) / var(--cols) * 2);
    }

    .hero-home__lead {
      padding-left: calc((100% + var(--gutter)) / var(--cols) * 2);
    }

    /* Tablet and up: a 200° field of view, so the places at rest are whole labels (G4 verdict,
       V14). Heavier than the component's own breakpoint rule; Città Digitali keeps 150°. */
    .hero--home .hero-home__horizon :global(.horizon) {
      --fov: 200;
    }
  }

  /* Phones: the +60° happen in the first 60svh of scroll, while the horizon is still visible
     below the sticky header; with 100svh only 24–34° are seen before it goes under the header,
     and Varese never leaves the edge fade (UI recheck R1). Never over less scroll than the strip
     travels (60vw = 60° of the 100° mobile field), so the strip never moves faster than the page,
     also on landscape phones (ux-designer, a11y §2.6). Heavier than the component's own rule:
     tablets, desktop and the Città Digitali horizon keep 0–100svh. */
  @media (max-width: 43.74em) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .hero--home .hero-home__horizon :global(.horizon__strip) {
        animation-range-end: max(60svh, 60vw);
      }
    }
  }

  @media (min-width: 64em) {
    /* Earth and lead are sized by their content: the horizon sits at ~57% at 1440 × 900. */
    .hero-home {
      min-height: clamp(40rem, calc(100svh - var(--header-h)), 60rem);
      grid-template-rows: [sky] 1fr [line] 0 [earth] auto [lead] auto;
    }

    .hero-home__lead {
      grid-column: 5 / span 7;
      padding-left: 0;
      padding-bottom: var(--space-xl); /* ends on the same line as the observer's caption */
      align-self: start;
    }

    .hero-home__r2 {
      padding-left: calc((100% + var(--gutter)) / var(--cols) * 4);
    }

    .hero-home__kicker {
      grid-column: 1 / span 7;
      max-width: none;
    }

    .hero-home__caption {
      grid-column: 1 / span 4;
      grid-row: earth / span 2;
      align-self: end;
      padding-bottom: var(--space-xl);
    }
  }

  /* ─── Line and compact ─── */
  .hero-line {
    padding-block: var(--space-xl) var(--section-pad-tight);
    row-gap: var(--space-l);
  }

  .hero-line__eyebrow {
    grid-column: 1 / -1;
    color: var(--fg-2);
  }

  .hero-line__title {
    grid-column: 1 / -1;
    margin: 0;
  }

  .hero-line__name {
    display: block;
    font-size: var(--fs-display-xl);
    line-height: var(--lh-display-xl);
    letter-spacing: var(--tr-display-xl);
  }

  .hero-line__name--xxl {
    font-size: var(--fs-display-xxl);
    line-height: var(--lh-display-xxl);
    letter-spacing: var(--tr-display-xxl);
  }

  .hero-line__descriptor {
    display: block;
    margin-top: var(--space-s);
    max-width: 22ch;
    font-size: var(--fs-display-m);
    line-height: var(--lh-display-m);
    letter-spacing: var(--tr-display-m);
    font-weight: var(--fw-regular);
  }

  .hero-line__body {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--space-l);
    justify-items: start;
  }

  .hero-line__visual {
    grid-column: 1 / -1;
  }

  @media (min-width: 64em) {
    .hero--line:has(.hero-line__visual) .hero-line__title,
    .hero--line:has(.hero-line__visual) .hero-line__body,
    .hero--line:has(.hero-line__visual) .hero-line__eyebrow {
      grid-column: 1 / span 7;
    }

    .hero--line .hero-line__visual {
      grid-column: 8 / -1;
      grid-row: 1 / span 3;
      align-self: end;
    }
  }
</style>

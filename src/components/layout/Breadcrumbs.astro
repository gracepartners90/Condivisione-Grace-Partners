---
/**
 * Visible breadcrumb trail for inner pages (mirrors the BreadcrumbList JSON-LD).
 */
import type { Crumb } from '../../lib/structured-data';

interface Props {
  crumbs: Crumb[];
  class?: string;
}

const { crumbs, class: className } = Astro.props;
---

<nav class:list={['breadcrumbs', className]} aria-label="Percorso">
  <ol>
    {crumbs.map((crumb, index) => (
      <li>
        {index < crumbs.length - 1 ? <a href={crumb.path}>{crumb.name}</a> : <span aria-current="page">{crumb.name}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-label, 0.8125rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .breadcrumbs li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .breadcrumbs li + li::before {
    content: '/';
    opacity: 0.5;
  }
  .breadcrumbs a {
    color: inherit;
    text-decoration: none;
    opacity: 0.72;
    padding-block: 0.35rem;
  }
  .breadcrumbs a:hover {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>

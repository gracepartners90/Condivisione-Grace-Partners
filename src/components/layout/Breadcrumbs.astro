---
/**
 * Visible breadcrumb trail for inner pages (mirrors the BreadcrumbList JSON-LD).
 * Placed right before <main>, visually at the top of the hero (docs/ux/sitemap.md §5).
 */
import type { Crumb } from '../../lib/structured-data';

interface Props {
  crumbs: Crumb[];
  class?: string;
}

const { crumbs, class: className } = Astro.props;
---

<nav class:list={['breadcrumbs', className]} aria-label="Percorso">
  <ol role="list">
    {
      crumbs.map((crumb, index) => (
        <li>
          {index > 0 && (
            <span class="breadcrumbs__sep" aria-hidden="true">
              /
            </span>
          )}
          {index < crumbs.length - 1 ? <a href={crumb.path}>{crumb.name}</a> : <span aria-current="page">{crumb.name}</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.6rem;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
    color: var(--fg-2);
  }

  .breadcrumbs li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .breadcrumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    padding-block: 0.35rem;
    color: var(--fg-2);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--link-underline);
  }

  .breadcrumbs [aria-current='page'] {
    color: var(--fg);
  }
</style>

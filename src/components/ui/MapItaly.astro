---
/**
 * Le Coordinate — cartography drawn with a 1 px line (visual direction §1.4).
 * Uses src/data/maps.json (Natural Earth outlines, one Lambert conformal conic projection,
 * generated by scripts/generate-maps.mjs) when available; otherwise a graticule with the real
 * places in an equirectangular frame. Places are decorative here: the real links sit next
 * to the map, so the whole figure is aria-hidden.
 */
import { formatCoords } from '../../lib/geo';

type MapPlace = { id: string; name: string; lat: number; lon: number };
type PlacePoint = { id: string; x: number; y: number; role?: string };
type MapLabel = { text: string; x: number; y: number; anchor?: 'start' | 'middle' | 'end' };
type MapData = {
  viewBox: string;
  viewBoxCompact?: string;
  path: string;
  places: PlacePoint[] | Record<string, { x: number; y: number }>;
  labels?: MapLabel[];
};

interface Props {
  map: 'italia' | 'puglia';
  places: MapPlace[];
  showLabels?: boolean;
  /** Puglia: crop to the stretch of coast around the places. */
  compact?: boolean;
  /** Id of the place drawn as the office (ring around the node). */
  home?: string;
  /** Custom viewBox (a crop of the map's own coordinates), e.g. a wide band of coast. */
  frame?: string;
  class?: string;
}

const { map, places, showLabels = true, compact = false, home, frame, class: className } = Astro.props;

const files = import.meta.glob<{ default: Record<string, unknown> }>('../../data/maps.json', { eager: true });
const raw = Object.values(files)[0]?.default as { maps?: Record<string, MapData> } & Record<string, MapData> | undefined;
const data: MapData | undefined = raw?.maps?.[map] ?? raw?.[map];

// Fallback frame: bounding boxes of the two maps.
const BOUNDS = {
  italia: { minLon: 6.5, maxLon: 18.6, minLat: 36.5, maxLat: 47.2 },
  puglia: { minLon: 15.8, maxLon: 17.8, minLat: 40.4, maxLat: 41.35 },
}[map];
const W = 400;
const kx = Math.cos(((BOUNDS.minLat + BOUNDS.maxLat) / 2) * (Math.PI / 180));
const H = Math.round((W * (BOUNDS.maxLat - BOUNDS.minLat)) / ((BOUNDS.maxLon - BOUNDS.minLon) * kx));
const project = (lat: number, lon: number) => ({
  x: ((lon - BOUNDS.minLon) / (BOUNDS.maxLon - BOUNDS.minLon)) * W,
  y: ((BOUNDS.maxLat - lat) / (BOUNDS.maxLat - BOUNDS.minLat)) * H,
});

const viewBox = (data && frame) || (compact && data?.viewBoxCompact) || data?.viewBox || `0 0 ${W} ${H}`;
const [vbX, vbY, vbW, vbH] = viewBox.split(/\s+/).map(Number);
const pct = (x: number, y: number) => ({ left: ((x - vbX) / vbW) * 100, top: ((y - vbY) / vbH) * 100 });

const lookup = (id: string) => {
  const list = data?.places;
  if (Array.isArray(list)) return list.find((p) => p.id === id);
  return list?.[id] ? { id, ...list[id] } : undefined;
};

const points = places.map((p) => {
  const pt = lookup(p.id) ?? project(p.lat, p.lon);
  const pos = pct(pt.x, pt.y);
  // Labels of places in the eastern part of the map hang to the left, so they stay inside it.
  return { ...p, ...pos, isHome: p.id === home, labelLeft: pos.left > 55 };
});
const labels = (data?.labels ?? []).map((l) => ({ ...l, ...pct(l.x, l.y) }));

// Graticule every degree (fallback only).
const graticule: string[] = [];
if (!data) {
  for (let lon = Math.ceil(BOUNDS.minLon); lon <= BOUNDS.maxLon; lon++) {
    const { x } = project(BOUNDS.minLat, lon);
    graticule.push(`M${x.toFixed(1)} 0V${H}`);
  }
  for (let lat = Math.ceil(BOUNDS.minLat); lat <= BOUNDS.maxLat; lat++) {
    const { y } = project(lat, BOUNDS.minLon);
    graticule.push(`M0 ${y.toFixed(1)}H${W}`);
  }
}
---

<div class:list={['map', `map--${map}`, { 'map--fallback': !data, 'map--compact': compact || Boolean(frame) }, className]} style={`aspect-ratio: ${vbW} / ${vbH}`} aria-hidden="true">
  <svg class="map__svg" viewBox={viewBox} preserveAspectRatio="xMidYMid meet" focusable="false">
    {data ? <path class="map__coast" d={data.path} vector-effect="non-scaling-stroke" /> : <path class="map__grid" d={graticule.join('')} vector-effect="non-scaling-stroke" />}
  </svg>
  {
    showLabels &&
      labels.map((l) => (
        <span class:list={['map__area t-label', `map__area--${l.anchor ?? 'start'}`]} style={`left: ${l.left}%; top: ${l.top}%`}>
          {l.text}
        </span>
      ))
  }
  {
    points.map((p, i) => (
      <span class:list={['map__place', { 'map__place--home': p.isHome, 'map__place--label-left': p.labelLeft }]} style={`left: ${p.left}%; top: ${p.top}%; --i: ${i}`} data-place={p.id}>
        <span class="map__node" />
        {showLabels && (
          <span class="map__label t-label">
            <span>{p.name}</span>
            <span class="map__coords">{formatCoords(p)}</span>
          </span>
        )}
      </span>
    ))
  }
</div>

<style>
  .map {
    position: relative;
    width: 100%;
    color: var(--fg);
    container-type: inline-size;
  }

  .map__svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .map__coast {
    fill: none;
    stroke: currentColor;
    stroke-width: 1px;
    stroke-linejoin: round;
  }

  .map__grid {
    fill: none;
    stroke: var(--line);
    stroke-width: 1px;
  }

  .map__place {
    position: absolute;
    width: 0;
    height: 0;
  }

  /* A place is a solid 10 px dot in terra/orange (§1.3); no halo, no glow. */
  .map__node {
    position: absolute;
    left: -5px;
    top: -5px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--place);
    transition: transform var(--dur-250) var(--ease-out);
  }

  .map__place.is-active .map__node {
    transform: scale(1.5);
  }

  /* The office: a ring around the node, like the «o» of the logo. */
  .map__place--home .map__node::after {
    content: '';
    position: absolute;
    inset: -8px;
    border: 1px solid var(--place);
    border-radius: 50%;
  }

  /* Area names (sea, uplands) may break over two lines, like on a printed map: at 320 px
     «MARE ADRIATICO» would otherwise run past the edge. */
  .map__area {
    position: absolute;
    width: max-content;
    max-width: 8em;
    color: var(--fg-2);
    transform: translateY(-50%);
  }

  .map__area--middle {
    transform: translate(-50%, -50%);
  }

  .map__area--end {
    transform: translate(-100%, -50%);
  }

  .map__label {
    position: absolute;
    left: 14px;
    top: -0.7em;
    display: grid;
    width: max-content;
    white-space: nowrap;
    color: var(--fg);
  }

  /* Long names wrap (e.g. «Acquaviva delle / Fonti»); a knockout in the surface colour keeps
     the text readable where it crosses the coastline. */
  .map__label > span,
  .map__area {
    padding-inline: 2px;
    background: var(--bg);
  }

  .map__label > span:first-child {
    max-width: 11em;
    white-space: normal;
  }

  .map__place--label-left .map__label {
    left: auto;
    right: 14px;
    justify-items: end;
    text-align: right;
  }

  .map__coords {
    color: var(--fg-2);
  }

  /* Small maps (phones): names only, the coordinates would collide. */
  @container (max-width: 25rem) {
    .map__coords {
      display: none;
    }
  }

  /* The compact frame crops the coastline: clip it to the frame. */
  .map--compact .map__svg {
    overflow: clip;
  }
</style>

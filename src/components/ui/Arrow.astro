---
/**
 * CTA arrows as inline SVG (the brand fonts lack → ↓ ↗ in their latin subsets).
 * Always decorative: the link text carries the meaning.
 */
interface Props {
  dir?: 'right' | 'down' | 'up' | 'external';
  class?: string;
}

const { dir = 'right', class: className } = Astro.props;
const paths = {
  right: 'M1.5 8h12M9.5 4l4 4-4 4',
  down: 'M8 1.5v12M4 9.5l4 4 4-4',
  up: 'M8 14.5v-12M4 6.5l4-4 4 4',
  external: 'M3.5 12.5l9-9M6 3.5h6.5V10',
};
---

<svg class:list={['arrow', `arrow--${dir}`, className]} viewBox="0 0 16 16" aria-hidden="true" focusable="false">
  <path d={paths[dir]} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter"></path>
</svg>

<style>
  .arrow {
    display: inline-block;
    width: 0.8em;
    height: 0.8em;
    flex: none;
    vertical-align: -0.05em;
    overflow: visible;
  }
</style>

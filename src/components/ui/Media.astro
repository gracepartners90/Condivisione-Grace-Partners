---
/**
 * Media: an optimised <picture> when the client asset exists, otherwise a declared
 * placeholder that states which asset is needed (docs/creativa/direzione-visiva.md §4.5):
 * same format as the final asset (no CLS on replacement), crop marks, kind, brief, format
 * and, for places, coordinates. Slots are listed in src/data/asset-slots.ts.
 * With PUBLIC_SLOT_MODE=publish the placeholder becomes its typographic variant (SlotPending).
 * Rectangles are space: radius 0, no shadows (§1.2).
 */
import type { ImageMetadata } from 'astro';
import { Picture, getImage } from 'astro:assets';
import SlotPending from './SlotPending.astro';
import { assetSlots, SLOT_MODE, type AssetSlotId } from '../../data/asset-slots';
import { formatCoords } from '../../lib/geo';

interface Props {
  image?: ImageMetadata;
  alt?: string;
  /** Required when `image` is missing: which asset this space is waiting for. */
  asset?: AssetSlotId;
  sizes?: string;
  widths?: number[];
  /** CSS aspect-ratio, e.g. "16 / 9". Defaults to the image ratio or the slot ratio. */
  ratio?: string;
  priority?: boolean;
  position?: string;
  /** Publish variant only: false drops name and place where the text around does not say them
      (they would be visible but hidden from assistive technology, WCAG 1.3.1). */
  pendingText?: boolean;
  /**
   * Art direction below 64em (or `media`): the same image cropped to another ratio at build time (e.g. 4 / 5
   * for a 3:5 door shown 4:5 on phones), with its own widths. Phones then download only the
   * pixels they show, not a taller image that object-fit crops (docs/performance/budget.md §4).
   * `image`: crop another source instead, when `image` is itself a crop that phones must not use
   * (e.g. a desktop derivative that leaves out what the phone crop keeps), or another view of the same
   * thing (e.g. the smartphone view of a SIII whose desktop view is `image`).
   * `media`: where the crop applies, when it should stop before 64em (e.g. portrait phones only).
   * `quality`: encoder quality of the crop only, when its texture breaks the weight targets of
   * docs/performance/budget.md §4 at the site defaults (AVIF 50, WebP 75); the other sources keep them.
   */
  mobileCrop?: {
    ratio: number;
    widths?: number[];
    position?: string;
    image?: ImageMetadata;
    media?: string;
    quality?: { avif?: number; webp?: number };
  };
  /**
   * Extra AVIF widths for screens of 1.5 dppx and more (desktops and tablets at 2x), for a detailed
   * image that would look soft there. They go in a source with media="(min-resolution: 1.5dppx)" that
   * has every width, these included, so phones at 1.75x–3x keep choosing by need. The other AVIF, WebP
   * and JPEG sources stop at `widths`: WebP and JPEG at these widths would break the per-file limits
   * of docs/performance/budget.md (check 8).
   */
  hiDpiAvifWidths?: number[];
  class?: string;
}

const {
  image,
  alt = '',
  asset,
  sizes = '100vw',
  widths = [480, 768, 1080, 1440, 1920],
  ratio,
  priority = false,
  position = '50% 50%',
  pendingText = true,
  mobileCrop,
  hiDpiAvifWidths,
  class: className,
} = Astro.props;

if (!image && !asset) throw new Error('Media: pass either `image` or `asset`.');

const slot = asset ? assetSlots[asset] : undefined;
const aspect = ratio ?? (image ? `${image.width} / ${image.height}` : (slot?.ratio ?? '4 / 3'));
// Never upscale: keep the widths the source can serve, plus its native width.
const usableWidths = image
  ? [...new Set([...widths.filter((w) => w < image.width), Math.min(image.width, Math.max(...widths))])]
  : [];

// Sources built here instead of <Picture> when a viewport or a screen density needs its own widths.
// - Art direction (mobileCrop): mobile sources cropped by sharp (fit cover), first, so they win below 64em
//   (or where mobileCrop.media says).
// - High density (hiDpiAvifWidths): an AVIF source for 1.5 dppx and more with every width, before the
//   normal sources. Without either prop Media renders <Picture>.
const MOBILE_MEDIA = mobileCrop?.media ?? '(max-width: 63.99em)';
const HIDPI_MEDIA = '(min-resolution: 1.5dppx)';
const hiDpiWidths =
  image && hiDpiAvifWidths ? [...new Set([...usableWidths, ...hiDpiAvifWidths.filter((w) => w <= image.width)])].sort((a, b) => a - b) : undefined;
const art =
  image && (mobileCrop || hiDpiWidths)
    ? await (async () => {
        const full = { src: image, widths: usableWidths };
        const [avif, webp, jpg, hiDpi] = await Promise.all([
          getImage({ ...full, format: 'avif' }),
          getImage({ ...full, format: 'webp' }),
          getImage({ ...full, format: 'jpg' }),
          hiDpiWidths ? getImage({ src: image, widths: hiDpiWidths, format: 'avif' }) : undefined,
        ]);
        if (!mobileCrop) return { avif, webp, jpg, hiDpi, mobile: undefined };
        const mImage = mobileCrop.image ?? image;
        const mWidths = [...new Set((mobileCrop.widths ?? [480, 640, 768]).filter((w) => w <= mImage.width))];
        const mWidth = Math.max(...mWidths);
        const mHeight = Math.round(mWidth / mobileCrop.ratio);
        const crop = { src: mImage, width: mWidth, height: mHeight, widths: mWidths, fit: 'cover' as const, position: mobileCrop.position ?? 'centre' };
        const [mAvif, mWebp] = await Promise.all([
          getImage({ ...crop, format: 'avif', quality: mobileCrop.quality?.avif }),
          getImage({ ...crop, format: 'webp', quality: mobileCrop.quality?.webp }),
        ]);
        return { avif, webp, jpg, hiDpi, mobile: { avif: mAvif, webp: mWebp, width: mWidth, height: mHeight } };
      })()
    : undefined;
---

{
  image && art ? (
    <picture class="media-picture" style={`--media-ratio: ${aspect}`}>
      {art.mobile && <source media={MOBILE_MEDIA} type="image/avif" srcset={art.mobile.avif.srcSet.attribute} sizes={sizes} width={art.mobile.width} height={art.mobile.height} />}
      {art.mobile && <source media={MOBILE_MEDIA} type="image/webp" srcset={art.mobile.webp.srcSet.attribute} sizes={sizes} width={art.mobile.width} height={art.mobile.height} />}
      {art.hiDpi && <source media={HIDPI_MEDIA} type="image/avif" srcset={art.hiDpi.srcSet.attribute} sizes={sizes} />}
      <source type="image/avif" srcset={art.avif.srcSet.attribute} sizes={sizes} />
      <source type="image/webp" srcset={art.webp.srcSet.attribute} sizes={sizes} />
      <img
        src={art.jpg.src}
        srcset={art.jpg.srcSet.attribute}
        sizes={sizes}
        alt={alt}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding={priority ? 'sync' : 'async'}
        style={`object-position: ${position}`}
        width={image.width}
        height={image.height}
        class:list={['media', className]}
      />
    </picture>
  ) : image ? (
    <Picture
      src={image}
      alt={alt}
      widths={usableWidths}
      sizes={sizes}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding={priority ? 'sync' : 'async'}
      class:list={['media', className]}
      pictureAttributes={{ class: 'media-picture', style: `--media-ratio: ${aspect}` }}
      style={`object-position: ${position}`}
    />
  ) : SLOT_MODE === 'publish' && slot && asset ? (
    <SlotPending {...slot.publish} {...(pendingText ? {} : { name: undefined, meta: undefined })} ratio={aspect} asset={asset} class={className} />
  ) : (
    <div class:list={['media-slot', className]} style={`--media-ratio: ${aspect}`} aria-hidden="true" data-asset-slot={asset}>
      <span class="media-slot__inner">
        <span class="media-slot__kind t-label">Asset richiesto · {slot?.kind}</span>
        <span class="media-slot__brief">
          <span class="media-slot__label">{slot?.label}</span>
          <span class="media-slot__spec">{slot?.spec}</span>
        </span>
        <span class="media-slot__meta t-label">
          <span>{slot?.format}</span>
          {slot?.coords && <span>{formatCoords(slot.coords)}</span>}
        </span>
      </span>
    </div>
  )
}

<style is:global>
  .media-picture {
    display: block;
    aspect-ratio: var(--media-ratio);
    overflow: clip;
  }

  .media {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Declared placeholder (work in progress). */
  .media-slot {
    --mark: var(--fg-2);
    position: relative;
    container-type: inline-size;
    aspect-ratio: var(--media-ratio);
    background: var(--slot-bg);
    color: var(--fg);
    border: var(--hairline) solid var(--line);
  }

  .media-slot__inner {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template: 'kind kind' auto '. .' 1fr 'brief meta' auto / minmax(0, 1fr) auto;
    gap: var(--space-xs) var(--space-s);
    padding: calc(8px + var(--space-s));
    overflow: hidden;
  }

  /* Four L-shaped crop marks, 12 px long, 8 px from the edges. */
  .media-slot::before {
    content: '';
    position: absolute;
    inset: 8px;
    pointer-events: none;
    background:
      linear-gradient(var(--mark), var(--mark)) top left / 12px 1px no-repeat,
      linear-gradient(var(--mark), var(--mark)) top left / 1px 12px no-repeat,
      linear-gradient(var(--mark), var(--mark)) top right / 12px 1px no-repeat,
      linear-gradient(var(--mark), var(--mark)) top right / 1px 12px no-repeat,
      linear-gradient(var(--mark), var(--mark)) bottom left / 12px 1px no-repeat,
      linear-gradient(var(--mark), var(--mark)) bottom left / 1px 12px no-repeat,
      linear-gradient(var(--mark), var(--mark)) bottom right / 12px 1px no-repeat,
      linear-gradient(var(--mark), var(--mark)) bottom right / 1px 12px no-repeat;
  }

  .media-slot__kind {
    grid-area: kind;
    color: var(--fg-2);
  }

  .media-slot__brief {
    grid-area: brief;
    display: grid;
    gap: var(--space-3xs);
    max-width: 44ch;
    font-size: var(--fs-small);
    line-height: var(--lh-small);
  }

  .media-slot__spec {
    color: var(--fg-2);
  }

  .media-slot__meta {
    grid-area: meta;
    display: grid;
    justify-items: end;
    align-self: end;
    text-align: right;
    color: var(--fg-2);
  }

  /* Very narrow slots (doors on phones): kind, name and format only. */
  @container (max-width: 12rem) {
    .media-slot__inner {
      padding: calc(8px + var(--space-2xs));
      gap: var(--space-2xs);
    }

    .media-slot__spec,
    .media-slot__meta span + span {
      display: none;
    }

    .media-slot__brief {
      font-size: 0.8125rem;
      line-height: 1.35;
    }
  }

  /* Narrow slots (portrait doors on mobile): stack the corners. */
  @container (max-width: 22rem) {
    .media-slot__inner {
      grid-template: 'kind' auto '.' 1fr 'brief' auto 'meta' auto / minmax(0, 1fr);
    }

    .media-slot__meta {
      justify-items: start;
      text-align: left;
    }
  }
</style>

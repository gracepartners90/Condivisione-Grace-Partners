---
/**
 * 404 — «404°»: a bearing that does not exist on a compass, like the page
 * (docs/creativa/direzione-visiva.md §7.8). Copy: docs/contenuti/microcopy.md §9.
 * noindex, no breadcrumb, no JSON-LD (docs/ux/sitemap.md T5).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/ui/Arrow.astro';
import { site } from '../data/site';

const worlds = [
  { bearing: '000°', name: 'SIII', statement: 'Spazi reali. Esperienze digitali.', label: 'Esplora SIII', href: '/siii/', id: '404-siii' },
  {
    bearing: '120°',
    name: 'Puglia Digitale',
    statement: 'Un territorio. Migliaia di storie.',
    label: 'Scopri Puglia Digitale',
    href: '/puglia-digitale/',
    id: '404-puglia-digitale',
  },
  {
    bearing: '240°',
    name: 'Città Digitali',
    statement: 'Le attività del territorio, online senza perdere radici.',
    label: 'Esplora Città Digitali',
    href: '/citta-digitali/',
    id: '404-citta-digitali',
  },
];
---

<BaseLayout page="404">
  <section class="nf surface-calce" aria-labelledby="hero-title">
    <div class="wrap grid nf__grid">
      <p class="nf__eyebrow t-label">Errore 404</p>
      <p class="nf__bearing" aria-hidden="true">404°</p>
      <h1 id="hero-title" class="nf__title">Questa pagina non esiste.</h1>
      <p class="nf__text">
        Forse l’indirizzo contiene un errore, oppure la pagina è stata spostata. Tutto il resto è da esplorare: riparti da qui.
      </p>
    </div>

    <div class="wrap">
      <ol role="list" class="nf__worlds">
        {
          worlds.map((w, i) => (
            <li class="nf__world" style={`--i: ${i}`}>
              <span class="nf__node" aria-hidden="true" />
              <p class="nf__world-bearing t-label" aria-hidden="true">
                {w.bearing}
              </p>
              <p class="nf__world-name">{w.name}</p>
              <p class="nf__world-statement">{w.statement}</p>
              <a class="nf__world-link" href={w.href} data-track="cta_click" data-cta-id={w.id} data-cta-location="404">
                {w.label}
                <Arrow dir="right" />
              </a>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="wrap grid nf__grid nf__more">
      <p>
        Cercavi qualcos’altro?
        <a href="/contatti/" data-track="cta_click" data-cta-id="404-parliamone" data-cta-location="404">Parliamone <Arrow dir="right" /></a>
      </p>
      <p><a href="/">Torna alla home <Arrow dir="right" /></a></p>
      <p class="nf__report">
        Hai trovato un link che non funziona sul nostro sito? Segnalacelo a <a href={`mailto:${site.email}`} data-track="contact_click" data-cta-id="404-email" data-cta-location="404" data-contact-method="email">{site.email}</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: var(--space-xl) var(--section-pad);
  }

  .nf__grid {
    row-gap: var(--space-m);
  }

  .nf__grid > * {
    grid-column: 1 / -1;
  }

  .nf__eyebrow {
    color: var(--fg-2);
  }

  .nf__bearing {
    font-size: var(--fs-display-xxl);
    line-height: var(--lh-display-xxl);
    letter-spacing: var(--tr-display-xxl);
    font-weight: var(--fw-strong);
    font-variant-numeric: proportional-nums;
  }

  .nf__title {
    margin: 0;
    font-size: var(--fs-display-m);
    line-height: var(--lh-display-m);
    letter-spacing: var(--tr-display-m);
  }

  .nf__text {
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    max-width: var(--measure-lead);
  }

  /* The three worlds on a horizon, at 000°, 120° and 240°. */
  .nf__worlds {
    display: grid;
    gap: var(--space-xl);
    margin: var(--space-3xl) 0 var(--space-2xl);
    padding: var(--space-xl) 0 0;
    border-top: 1px solid var(--fg);
  }

  .nf__world {
    position: relative;
    display: grid;
    gap: var(--space-2xs);
    justify-items: start;
  }

  .nf__node {
    position: absolute;
    top: calc(-1 * var(--space-xl) - 5px);
    left: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--node);
  }

  .nf__world-bearing {
    color: var(--fg-2);
  }

  .nf__world-name {
    font-size: var(--fs-display-s);
    line-height: var(--lh-display-s);
    letter-spacing: var(--tr-display-s);
    font-weight: var(--fw-strong);
  }

  .nf__world-statement {
    max-width: 28ch;
  }

  .nf__world-link,
  .nf__more a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: var(--tap-min);
    font-weight: var(--fw-strong);
  }

  .nf__report {
    font-size: var(--fs-small);
    color: var(--fg-2);
  }

  .nf__report a {
    font-weight: var(--fw-regular);
  }

  /* Stacked on phones: only the first world sits on the horizon line. */
  @media (max-width: 63.99em) {
    .nf__world + .nf__world .nf__node {
      display: none;
    }
  }

  @media (min-width: 64em) {
    .nf__grid > .nf__title {
      grid-column: 1 / span 8;
    }

    .nf__worlds {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--gutter);
    }

    .nf__grid.nf__more > * {
      grid-column: 1 / span 8;
    }
  }
</style>

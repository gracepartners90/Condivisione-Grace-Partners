---
/**
 * 404 — «404°»: a bearing that does not exist on a compass, like the page
 * (docs/creativa/direzione-visiva.md §7.8). Copy: docs/contenuti/microcopy.md §9.
 * noindex, no breadcrumb, no JSON-LD (docs/ux/sitemap.md T5).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/ui/Arrow.astro';
import { site } from '../data/site';

const worlds = [
  { bearing: '000°', name: 'SIII', statement: 'Spazi reali. Esperienze digitali.', label: 'Esplora SIII', href: '/siii/', id: '404-siii' },
  {
    bearing: '120°',
    name: 'Puglia Digitale',
    statement: 'Un territorio. Migliaia di storie.',
    label: 'Scopri Puglia Digitale',
    href: '/puglia-digitale/',
    id: '404-puglia-digitale',
  },
  {
    bearing: '240°',
    name: 'Città Digitali',
    statement: 'Le attività del territorio, online senza perdere radici.',
    label: 'Esplora Città Digitali',
    href: '/citta-digitali/',
    id: '404-citta-digitali',
  },
];
---

<BaseLayout page="404">
  <section class="nf surface-calce" aria-labelledby="hero-title">
    <div class="wrap grid nf__grid">
      <p class="nf__eyebrow t-label">Errore 404</p>
      <p class="nf__bearing" aria-hidden="true">404°</p>
      <h1 id="hero-title" class="nf__title">Questa pagina non esiste.</h1>
      <p class="nf__text">
        Forse l’indirizzo contiene un errore, oppure la pagina è stata spostata. Tutto il resto è da esplorare: riparti da qui.
      </p>
    </div>

    <div class="wrap">
      <ol role="list" class="nf__worlds">
        {
          worlds.map((w, i) => (
            <li class="nf__world" style={`--i: ${i}`}>
              <p class="nf__world-bearing t-label" aria-hidden="true">
                {w.bearing}
              </p>
              <p class="nf__world-name">{w.name}</p>
              <p class="nf__world-statement">{w.statement}</p>
              <a class="nf__world-link" href={w.href} data-track="cta_click" data-cta-id={w.id} data-cta-location="404">
                <span class="nf__node" aria-hidden="true" />
                {w.label}
                <Arrow dir="right" />
              </a>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="wrap grid nf__grid nf__more">
      <p>
        Cercavi qualcos’altro?
        <a href="/contatti/" data-track="cta_click" data-cta-id="404-parliamone" data-cta-location="404">Parliamone <Arrow dir="right" /></a>
      </p>
      <p><a href="/">Torna alla home <Arrow dir="right" /></a></p>
      <p class="nf__report">
        Hai trovato un link che non funziona sul nostro sito? Segnalacelo a <a href={`mailto:${site.email}`} data-track="contact_click" data-cta-id="404-email" data-cta-location="404" data-contact-method="email">{site.email}</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: var(--space-xl) var(--section-pad);
  }

  .nf__grid {
    row-gap: var(--space-m);
  }

  .nf__grid > * {
    grid-column: 1 / -1;
  }

  .nf__eyebrow {
    color: var(--fg-2);
  }

  .nf__bearing {
    font-size: var(--fs-display-xxl);
    line-height: var(--lh-display-xxl);
    letter-spacing: var(--tr-display-xxl);
    font-weight: var(--fw-strong);
    font-variant-numeric: proportional-nums;
  }

  .nf__title {
    margin: 0;
    font-size: var(--fs-display-m);
    line-height: var(--lh-display-m);
    letter-spacing: var(--tr-display-m);
  }

  .nf__text {
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    max-width: var(--measure-lead);
  }

  /* The three worlds on a horizon, at 000°, 120° and 240°. The line is graduated like the
     Horizon (ticks every 5°, 15° and 45°, below the line): 360° span three columns and their
     gutters, so 120° and 240° fall exactly where the second and third world start. */
  .nf__worlds {
    --deg: calc((100% + var(--gutter)) / 72);
    position: relative;
    display: grid;
    gap: var(--space-xl);
    margin: var(--space-3xl) 0 var(--space-2xl);
    padding: var(--space-xl) 0 0;
    border-top: 1px solid var(--fg);
  }

  .nf__worlds::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 20px;
    pointer-events: none;
    background:
      linear-gradient(to right, var(--fg) 0 1px, transparent 1px) 0 0 / calc(var(--deg) * 9) 20px repeat-x,
      linear-gradient(to right, var(--fg) 0 1px, transparent 1px) 0 0 / calc(var(--deg) * 3) 12px repeat-x,
      linear-gradient(to right, var(--fg) 0 1px, transparent 1px) 0 0 / var(--deg) 6px repeat-x;
  }

  /* Each world starts at the top of its column, whatever the length of its statement (N6). */
  .nf__world {
    position: relative;
    display: grid;
    gap: var(--space-2xs);
    justify-items: start;
    align-content: start;
  }

  /* The node stands on the horizon but belongs to the link: it is part of what you click, and it
     shows its ring on hover and focus (Node anatomy: dot Ø 10, ring Ø 26). */
  .nf__node {
    position: absolute;
    top: calc(-1 * var(--space-xl) - 5px);
    /* Centred on the 1 px tick of its bearing, like the Horizon nodes (C14-4). */
    left: -4.5px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--node);
    outline: 1px solid transparent;
    outline-offset: 7px;
    transition: outline-color var(--dur-250) var(--ease-out);
  }

  .nf__world-link:is(:hover, :focus-visible) .nf__node {
    outline-color: var(--node);
  }

  .nf__world-bearing {
    color: var(--fg-2);
  }

  .nf__world-name {
    font-size: var(--fs-display-s);
    line-height: var(--lh-display-s);
    letter-spacing: var(--tr-display-s);
    font-weight: var(--fw-strong);
  }

  .nf__world-statement {
    max-width: 28ch;
  }

  .nf__world-link,
  .nf__more a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: var(--tap-min);
    font-weight: var(--fw-strong);
  }

  .nf__report {
    font-size: var(--fs-small);
    color: var(--fg-2);
  }

  .nf__report a {
    font-weight: var(--fw-regular);
  }

  /* Stacked on phones: only the first world sits on the horizon line. */
  @media (max-width: 63.99em) {
    .nf__world + .nf__world .nf__node {
      display: none;
    }
  }

  @media (min-width: 64em) {
    .nf__grid > .nf__title {
      grid-column: 1 / span 8;
    }

    .nf__worlds {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--gutter);
    }

    .nf__grid.nf__more > * {
      grid-column: 1 / span 8;
    }
  }

  /* Forced colors (Windows contrast themes): the system paints backgrounds in its canvas colour, drops
     gradients and paints the transparent outline that hides the ring at rest. Dot in the link colour,
     ring only on hover and focus, ticks redrawn like the Horizon's (accessibilita.md §2.14). */
  @media (forced-colors: active) {
    .nf__worlds::before {
      forced-color-adjust: none;
      background:
        linear-gradient(to right, CanvasText 0 1px, transparent 1px) 0 0 / calc(var(--deg) * 9) 20px repeat-x,
        linear-gradient(to right, CanvasText 0 1px, transparent 1px) 0 0 / calc(var(--deg) * 3) 12px repeat-x,
        linear-gradient(to right, CanvasText 0 1px, transparent 1px) 0 0 / var(--deg) 6px repeat-x;
    }

    .nf__node {
      forced-color-adjust: none;
      background: LinkText;
    }

    .nf__world-link:is(:hover, :focus-visible) .nf__node {
      outline-color: LinkText;
    }
  }
</style>

---
/**
 * Home — «L'orizzonte dei luoghi». Copy: docs/contenuti/copy-deck/home.md.
 * Rhythm: docs/creativa/direzione-visiva.md §7.3.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import LargeStatement from '../components/sections/LargeStatement.astro';
import ImmersivePreview from '../components/sections/ImmersivePreview.astro';
import Marquee from '../components/sections/Marquee.astro';
import SectionIntro from '../components/sections/SectionIntro.astro';
import ProjectShowcase from '../components/sections/ProjectShowcase.astro';
import FounderTimeline from '../components/sections/FounderTimeline.astro';
import CTASection from '../components/sections/CTASection.astro';
import Media from '../components/ui/Media.astro';
import MapItaly from '../components/ui/MapItaly.astro';
import { horizonPlaces, office, founder } from '../data/site';
import { founderPortrait, eventPhotoNote, siiiHomeScreen } from '../data/media';
import { bearing, distanceKm, formatCoords } from '../lib/geo';
import { pageGraph, person, ids } from '../lib/structured-data';
import eventoPanorama from '../assets/images/derivate/evento-panorama.jpg';
import eventoCitta from '../assets/images/derivate/evento-citta.jpg';
import maps from '../data/maps.json';
import { describeCittaDigitali, describePugliaDigitale } from '../lib/citta-digitali';

const places = horizonPlaces.map((p) => ({ id: p.id, name: p.name, bearing: bearing(office, p), km: distanceKm(office, p) }));
const schema = pageGraph('home', [person()], { about: ids.organization });

// Text alternative of the chapter 03 map: the names drawn at every width, north → south, so that every
// name said is on the map on a phone too (rule of copywriter-brand L7; ux-designer, 2026-10-06).
const drawnAtEveryWidth = (p: { anchor?: { wide?: string; narrow?: string } }) =>
  (['wide', 'narrow'] as const).every((c) => p.anchor?.[c] && p.anchor[c] !== 'none');
const mapLabel = describeCittaDigitali(
  [...maps.maps.italia.places].filter(drawnAtEveryWidth).sort((a, b) => b.lat - a.lat).map((p) => p.name),
);
// Chapter 02: the whole of Puglia with the cities of Puglia Digitale, as on /puglia-digitale/ (compact map;
// P4, approved by the user on 2026-10-07). Same rule for its text alternative (copywriter-brand, L7): the
// names drawn at every width, north → south, without the office, which has its own sentence.
type RegionPlace = { name: string; lat: number; role?: string; anchor: Record<'wide' | 'narrow', string> };
const regionPlaces = maps.maps.pugliaRegione.places as RegionPlace[];
const pugliaLabel = describePugliaDigitale(
  regionPlaces.filter((p) => p.role !== 'sede' && drawnAtEveryWidth(p)).sort((a, b) => b.lat - a.lat).map((p) => p.name),
  regionPlaces.find((p) => p.role === 'sede')?.name,
);
---

<BaseLayout page="home" schema={schema}>
  <Hero
    variant="home"
    eyebrow={'ITnode — oltre i confini del\u00a0Web tradizionale'}
    registers={['La tecnologia cambia.', 'La curiosità ci accompagna\nda sempre.']}
    lead={'Esperienze digitali immersive per\u00a0imprese e territori.'}
    places={places}
    caption={`Vista da ${office.name}\n${formatCoords(office)}\nDistanze in linea d’aria`}
  />

  <LargeStatement
    variant="manifesto"
    as="h2"
    id="chi-siamo"
    headingId="chi-siamo-title"
    eyebrow="Chi siamo"
    registers={['ITnode nasce dall’idea di creare un nuovo modo di abitare il Web.']}
    size="l"
    surface="pietra"
  >
    <p>
      ITnode è un’azienda di Acquaviva delle Fonti, in provincia di Bari, che rende gli spazi fisici esplorabili sul Web. Crea
      <a href="/siii/">Siti Interattivi Immersivi</a> (SIII) per le imprese. Con i Tour Virtuali Interattivi Immersivi porta online luoghi, imprese e
      attività in due progetti di digitalizzazione territoriale: <a href="/citta-digitali/">Città Digitali</a> e
      <a href="/puglia-digitale/">Puglia Digitale</a>.
    </p>
  </LargeStatement>

  <ImmersivePreview
    image={eventoPanorama}
    smallImage={eventoCitta}
    alt="La platea dell’evento Puglia Digitale; sul maxischermo a sinistra del palco, il tour virtuale di una città vista dall’alto."
    legendTitle="L’evento Puglia Digitale"
    note={eventPhotoNote}
    surface="pietra"
    hotspots={[
      { x: 13.3, y: 18, small: { x: 37.7, y: 18 }, label: 'Vista aerea a 360° di una città, con le attività in evidenza' },
      // On the lectern beside the speaker, not on a person (visual direction §4.2, N7).
      { x: 36, y: 31, label: 'Il palco dell’evento Puglia Digitale' },
      { x: 85, y: 16, label: 'Una piazza storica esplorabile a 360°' },
    ]}
  />

  <LargeStatement
    variant="passage"
    as="p"
    registers={['Una nuova infrastruttura digitale', 'per connettere imprese, cittadini e visitatori.']}
    size="l"
    secondSize="m"
    surface="notte"
    class="home-infra"
  >
    <Fragment slot="after">
      <div class="wrap">
        <Marquee items={['spazio fisico', 'spazio digitale', 'persone', 'imprese', 'territorio']} />
      </div>
    </Fragment>
  </LargeStatement>

  <section class="worlds" aria-labelledby="tre-mondi-title" id="tre-mondi">
    <div class="surface-notte worlds__intro">
      <div class="wrap grid worlds__grid">
        <SectionIntro id="tre-mondi-title" title="I tre mondi ITnode" size="label" class="worlds__head" />
        <p class="worlds__statement">Un’impresa. Un territorio. Una rete di città.</p>
        <p class="worlds__text" data-reveal>
          SIII, Puglia Digitale e Città Digitali sono tre applicazioni concrete della stessa visione. ITnode rende esplorabili gli spazi reali e usa
          questa tecnologia per valorizzare imprese e territori.
        </p>
      </div>
    </div>

    <ol role="list" class="worlds__list">
      <ProjectShowcase
        layout="a"
        surface="notte"
        number="01"
        bearing="000° · N"
        name="SIII"
        descriptor="Siti Interattivi Immersivi"
        statement={['Spazi reali.', 'Esperienze digitali.']}
        text="Il SIII replica digitalmente gli spazi della tua impresa. Chi entra li esplora da desktop e smartphone, guarda prodotti e video, chiede informazioni e prenota."
        cta={{ label: 'Esplora SIII', href: '/siii/', id: 'home-capitolo-siii' }}
      >
        <div slot="visual" class="worlds__screen aperture">
          {/* Masseria Santella's SIII from inside: the alt names it, the chapter text speaks of SIII in general. */}
          <Media image={siiiHomeScreen.image} alt={siiiHomeScreen.alt} sizes="(min-width: 100rem) 983px, (min-width: 64em) 62vw, 92vw" />
        </div>
      </ProjectShowcase>

      <ProjectShowcase
        layout="b"
        surface="calce"
        number="02"
        bearing="120°"
        name="Puglia Digitale"
        statement={['Un territorio.', 'Migliaia di storie.']}
        text="Un progetto di destination marketing che digitalizza città, borghi e imprese della Puglia. E li valorizza con esperienze immersive."
        cta={{ label: 'Scopri Puglia Digitale', href: '/puglia-digitale/', id: 'home-capitolo-puglia-digitale' }}
      >
        <figure slot="visual" class="worlds__atlas">
          <MapItaly map="pugliaRegione" cities home="acquaviva" label={pugliaLabel} class="worlds__map" />
          <figcaption class="worlds__atlas-note t-label">Ogni punto è una città di&nbsp;Puglia&nbsp;Digitale</figcaption>
        </figure>
      </ProjectShowcase>

      <ProjectShowcase
        layout="c"
        surface="pietra"
        number="03"
        bearing="240°"
        name="Città Digitali"
        statement={['Le attività del territorio,', 'online senza perdere radici.']}
        text="Tour virtuali, Siti Interattivi Immersivi e strumenti digitali per imprese e attività. Varese, Altamura, Caltanissetta: città diverse, un unico portale."
        cta={{ label: 'Esplora Città Digitali', href: '/citta-digitali/', id: 'home-capitolo-citta-digitali' }}
      >
        <figure slot="visual" class="worlds__atlas">
          <MapItaly map="italia" cities label={mapLabel} class="worlds__map" />
          <figcaption class="worlds__atlas-note t-label">Ogni punto è una città di&nbsp;Città&nbsp;Digitali</figcaption>
        </figure>
      </ProjectShowcase>
    </ol>
  </section>

  <FounderTimeline
    eyebrow="Il fondatore"
    title={['36 anni dentro l’innovazione.', 'E ancora la stessa curiosità.']}
    lead={`ITnode è stata fondata da ${founder.name}, che lavora nell’innovazione da 36 anni. Il suo percorso comincia con IBM negli anni ’90 e passa per la prima azienda, MyComm, iComm Lab e Leadstone. Oggi continua con ITnode, Puglia Digitale e Città Digitali.`}
    stages={[
      { when: 'Anni ’90', title: 'IBM', note: 'L’inizio del percorso.' },
      { when: '—', title: 'La prima azienda', note: 'Il primo passo da imprenditore.' },
      {
        when: 'Dal 2002',
        title: 'MyComm · iComm Lab · Leadstone',
        figure: { value: '10.000+', label: 'clienti, prima di ITnode', srText: 'Oltre 10.000 clienti, prima di ITnode' },
      },
      {
        when: 'Oggi',
        title: 'ITnode · Puglia Digitale · Città Digitali',
        links: [
          { label: 'ITnode', href: '' },
          { label: 'Puglia Digitale', href: '/puglia-digitale/' },
          { label: 'Città Digitali', href: '/citta-digitali/' },
        ],
        note: 'La stessa curiosità, applicata a spazi, imprese e territori.',
        now: true,
      },
    ]}
    portrait={founderPortrait.image}
    portraitAlt={founderPortrait.alt}
    portraitNote={founderPortrait.aiNote}
    quote="È questo il futuro che mi appassiona e che stiamo costruendo giorno dopo giorno."
    signature={`${founder.name}, fondatore di ITnode`}
    profile={{ label: `${founder.name} su LinkedIn`, href: founder.linkedin }}
  />

  <CTASection
    variant="band"
    id="chiusura"
    eyebrow="Il prossimo spazio"
    title={['Il Web si può abitare.', 'Cominciamo dal tuo spazio.']}
    text="Un’impresa, un’attività, un territorio: raccontaci che cosa vuoi rendere esplorabile. Ti aiutiamo a scegliere tra SIII, Puglia Digitale e Città Digitali."
    cta={{ label: 'Parliamone', href: '/contatti/', id: 'home-chiusura-parliamone' }}
    surface="notte"
  />
</BaseLayout>

<style>
  .home-infra {
    padding-bottom: var(--space-2xl);
  }

  .home-infra :global(.marquee) {
    margin-top: var(--space-3xl);
  }

  .worlds__intro {
    padding-block: var(--space-2xl) 0;
  }

  .worlds__grid {
    row-gap: var(--space-m);
  }

  .worlds__intro :global(.worlds__head),
  .worlds__statement,
  .worlds__text {
    grid-column: 1 / -1;
  }

  .worlds__statement {
    font-size: var(--fs-display-m);
    line-height: var(--lh-display-m);
    letter-spacing: var(--tr-display-m);
    color: var(--fg);
  }

  .worlds__text {
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    max-width: var(--measure-lead);
  }

  @media (min-width: 64em) {
    .worlds__statement {
      grid-column: 1 / span 10;
    }

    .worlds__text {
      grid-column: 7 / span 5;
    }
  }

  .worlds__list {
    margin: 0;
    padding: 0;
  }

  .worlds :global(.worlds__map) {
    max-width: 30rem;
    margin-inline: auto;
  }

  /* Chapter 03: the map and its one-line legend share the width of the map. */
  .worlds__atlas {
    max-width: 30rem;
    margin: 0 auto;
  }

  .worlds__atlas :global(.worlds__map) {
    max-width: none;
  }

  .worlds__atlas-note {
    margin-top: var(--space-s);
    color: var(--fg-2);
  }
</style>
